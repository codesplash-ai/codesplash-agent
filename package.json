{
  "name": "codesplash-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent": "./dist/cli.js"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "bun run format:check && bun run typecheck && bun test",
    "dev": "bun src/cli.ts",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "start": "bun dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.5.3",
    "@opentui/react": "0.5.3",
    "react": "19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "typescript": "5.9.2"
  }
}
