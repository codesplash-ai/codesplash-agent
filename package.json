{
  "name": "codesplash-agent",
  "version": "0.2.0",
  "description": "Terminal harness for Codex and Claude Code \u2014 your AI accounts, one terminal, credentials stay on your machine.",
  "license": "BUSL-1.1",
  "type": "module",
  "bin": {
    "codesplash": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "examples/sdk",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "extensions/vscode",
    "integrations",
    "docs/server.md",
    "docs/integrations.md",
    "docs/observability-and-tools.md",
    "docs/distribution.md",
    "docs/termux.md",
    "docs/agent-roadmap-status.md",
    "docs/storage-platform-boundaries.md",
    "docs/agent-carryovers.md",
    "docs/roadmap-release-handoff-2026-09-27.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codesplash-ai/codesplash-agent.git"
  },
  "homepage": "https://github.com/codesplash-ai/codesplash-agent#readme",
  "bugs": "https://github.com/codesplash-ai/codesplash-agent/issues",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && bun scripts/build-assets.ts",
    "release:build": "bun scripts/build-release.ts",
    "check": "bun run format:check && bun run typecheck && bun test",
    "dev": "bun scripts/dev.ts",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "preversion": "bun run check",
    "version": "bun scripts/sync-version.ts && bun scripts/check-changelog.ts && git add src/version.ts",
    "release:current": "bun run check && bun scripts/check-changelog.ts && git tag -a \"v$npm_package_version\" -m \"CodeSplash Agent v$npm_package_version\" && git push --atomic origin HEAD \"refs/tags/v$npm_package_version\"",
    "release:patch": "npm version patch && git push origin HEAD && git push origin --tags",
    "release:minor": "npm version minor && git push origin HEAD && git push origin --tags",
    "release:major": "npm version major && git push origin HEAD && git push origin --tags",
    "start": "bun dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "docs:build": "bun scripts/build-docs.ts out/docs",
    "release:manifest": "bun scripts/release-manifest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.75",
    "@aws-sdk/client-bedrock-runtime": "3.1141.0",
    "@aws-sdk/client-sts": "3.1141.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@opentui/core": "0.5.3",
    "@opentui/react": "0.5.3",
    "@types/node": "24.13.3",
    "@vscode/ripgrep-universal": "1.18.0",
    "ajv": "8.20.0",
    "beautiful-mermaid": "1.1.3",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "1.63.0",
    "react": "19.2.0",
    "shell-quote": "1.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/react": "19.2.18",
    "typescript": "5.9.2",
    "@types/bun": "1.3.14"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./extensions": {
      "types": "./dist/sdk/extensions.d.ts",
      "import": "./dist/sdk/extensions.js"
    },
    "./package.json": "./package.json",
    "./config.schema.json": "./dist/core/config/schema.json",
    "./managed.schema.json": "./dist/core/config/managed-schema.json"
  },
  "types": "./dist/sdk/index.d.ts"
}
